---
interface Props {
  items: string[];
}

const { items } = Astro.props;
const points = [
  [12.2, 25],
  [18.4, 55],
  [35.5, 55],
  [41.8, 12.2],
  [64, 36.7],
  [80, 36.7],
  [86.2, 70],
];
---

<div class="case-route">
  <svg viewBox="0 0 900 360" role="img" aria-label="A flexible route connecting different moments in a daily journey">
    <path d="M0 90 H110 Q138 90 138 118 V170 Q138 198 166 198 H320 Q348 198 348 170 V72 Q348 44 376 44 H520 Q548 44 548 72 V104 Q548 132 576 132 H720 Q748 132 748 160 V224 Q748 252 776 252 H900" />
    {[110, 166, 320, 376, 576, 720, 776].map((x, index) => {
      const y = [90, 198, 198, 44, 132, 132, 252][index];
      return <circle cx={x} cy={y} r="11" />;
    })}
  </svg>
  <ul>
    {items.map((item, index) => (
      <li style={`--x:${points[index][0]}%;--y:${points[index][1]}%`}>{item}</li>
    ))}
  </ul>
</div>
