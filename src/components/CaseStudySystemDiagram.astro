---
/* The "Elementos del sistema" diagram from the proposal, rebuilt with the
   original vector artwork: the module lifted from the Bicing mark, the
   chamfered Eixample block, the station photo, and the route line that
   threads through all four and branches on its way out. */

const QUATREFOIL = "M81.7406 41.5352C87.5125 37.3879 91.2718 30.6209 91.2718 22.9816C91.2718 10.3937 81.0252 0.159424 68.4373 0.159424C60.8093 0.159424 54.031 3.93071 49.896 9.69064C45.7488 3.91867 38.9817 0.159424 31.3424 0.159424C18.7546 0.159424 8.52026 10.406 8.52026 22.9816C8.52026 30.6096 12.2793 37.3879 18.0515 41.5352C12.2795 45.6824 8.52026 52.4495 8.52026 60.0765C8.52026 72.6644 18.7555 82.9109 31.3424 82.9109C38.9704 82.9109 45.7488 79.1397 49.896 73.3797C54.0433 79.1517 60.8103 82.9109 68.4373 82.9109C81.0252 82.9109 91.2718 72.6644 91.2718 60.0765C91.2718 52.4485 87.5005 45.6824 81.7406 41.5352ZM68.4371 8.72063C76.3068 8.72063 82.7099 15.1237 82.7099 22.9934C82.7099 28.6443 79.3993 33.5437 74.6212 35.8472C72.4502 26.413 65.0168 18.9795 55.5823 16.8084C57.8868 12.031 62.7864 8.72038 68.4371 8.72038V8.72063ZM17.0815 22.9811C17.0815 15.1114 23.4846 8.70834 31.3542 8.70834C37.0051 8.70834 41.9046 12.0189 44.2081 16.7971C34.7738 18.968 27.3403 26.4014 25.1692 35.8359C20.3918 33.5436 17.0812 28.645 17.0812 22.9811H17.0815ZM31.3419 74.3488C23.4723 74.3488 17.0692 67.9457 17.0692 60.076C17.0692 54.4251 20.3798 49.5257 25.1579 47.2222C27.3167 56.6564 34.7623 64.0899 44.1967 66.261C41.9045 71.0384 37.0058 74.349 31.3419 74.349V74.3488ZM54.0673 57.8204C52.7331 58.1599 51.3388 58.3423 49.8955 58.3423C48.4523 58.3423 47.0579 58.1608 45.7237 57.8204C45.6269 57.796 45.5178 57.7715 45.421 57.7358C39.7458 56.1713 35.2589 51.6844 33.6821 45.9969C33.6576 45.9001 33.6219 45.791 33.5975 45.6941C33.258 44.3599 33.0756 42.9656 33.0756 41.5223C33.0756 40.0791 33.2571 38.6847 33.5975 37.3505C33.6219 37.2537 33.6463 37.1446 33.6821 37.0478C35.2466 31.3726 39.7335 26.8857 45.4087 25.3211C45.5056 25.2967 45.6146 25.261 45.7115 25.2365C47.0457 24.8971 48.44 24.7147 49.8833 24.7147C51.3265 24.7147 52.7209 24.8962 54.0551 25.2365C54.1519 25.261 54.261 25.2854 54.3578 25.3211C60.033 26.8979 64.5199 31.3726 66.0845 37.0601C66.1211 37.1569 66.1446 37.266 66.1691 37.3628C66.5085 38.697 66.6909 40.0914 66.6909 41.5346C66.6909 42.9779 66.5095 44.3722 66.1691 45.7064C66.1446 45.8033 66.1202 45.9123 66.0845 46.0092C64.5199 51.6844 60.033 56.1713 54.3578 57.7358C54.2741 57.7715 54.1651 57.796 54.0673 57.8204ZM68.4378 74.3488C62.7869 74.3488 57.8875 71.0382 55.584 66.2601C65.0062 64.0891 72.4517 56.6557 74.6228 47.2212C79.4012 49.5257 82.7115 54.4244 82.7115 60.0751C82.7106 67.9457 76.3077 74.3488 68.4378 74.3488Z";

// The module icon's own bounding box, used to centre it in the frame.
const ICON_BOX = { x: 8.52, y: 0.16, w: 82.75, h: 82.75 };
const ICON_SIZE = 380;
const iconScale = ICON_SIZE / ICON_BOX.w;
const iconTx = 240 - iconScale * (ICON_BOX.x + ICON_BOX.w / 2);
const iconTy = 257 - iconScale * (ICON_BOX.y + ICON_BOX.h / 2);

const items = [
  { label: 'Everyday module', left: '12%' },
  { label: 'Urban grid', left: '36%' },
  { label: 'Public infrastructure', left: '60.75%' },
  { label: 'Personal route', left: '85%' },
];
---

<figure class="case-system-diagram">
  <svg viewBox="0 0 2000 560" role="img" aria-label="The four elements of the visual system, linked by the campaign route line: the module, the Eixample grid block, a docking station and the personal route.">
    {/* One unbroken run, drawn first so the elements themselves mask it. */}
    <path class="route" d="M380 257H1706" fill="none" stroke-width="20" stroke-linecap="butt" />

    <g fill="#ffffff">
      <path d={QUATREFOIL} transform={`translate(${iconTx} ${iconTy}) scale(${iconScale})`} />
      <polygon points="572.3,60.0 867.7,60.0 920.0,111.7 920.0,403.3 867.7,455.0 572.3,455.0 520.0,403.3 520.0,111.7" />
      <polygon points="1524.2,60.0 1660.8,60.0 1685.0,84.2 1685.0,220.8 1660.8,245.0 1524.2,245.0 1500.0,220.8 1500.0,84.2" />
      <polygon points="1739.2,60.0 1875.8,60.0 1900.0,84.2 1900.0,220.8 1875.8,245.0 1739.2,245.0 1715.0,220.8 1715.0,84.2" />
      <polygon points="1524.2,270.0 1660.8,270.0 1685.0,294.2 1685.0,430.8 1660.8,455.0 1524.2,455.0 1500.0,430.8 1500.0,294.2" />
      <polygon points="1739.2,270.0 1875.8,270.0 1900.0,294.2 1900.0,430.8 1875.8,455.0 1739.2,455.0 1715.0,430.8 1715.0,294.2" />
    </g>

    <clipPath id="case-system-photo">
      <rect x="1010" y="55" width="410" height="405" rx="32" />
    </clipPath>
    <image
      href="/images/graphic-design/bicing/system-infrastructure.webp"
      x="1010" y="55" width="410" height="405"
      preserveAspectRatio="xMidYMid slice"
      clip-path="url(#case-system-photo)"
    />

    {/* The branch rides over the blocks, as it does in the original. */}
    <g class="route" fill="none" stroke-width="20" stroke-linecap="round" stroke-linejoin="round">
      <path d="M1700 257L1848 109Q1930 27 1930 -33" />
      <path d="M1700 257L1848 405Q1908 465 1968 465H2060" />
    </g>
  </svg>
  <figcaption>
    {items.map((item) => (
      <span style={`left:${item.left}`}>{item.label}</span>
    ))}
  </figcaption>
</figure>

<style>
  .case-system-diagram {
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    padding: clamp(1rem, 3vw, 2rem) 0 0;
    background: #000000;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .route,
  .route path {
    stroke: var(--case-red, #DF2935);
  }
  figcaption {
    position: relative;
    height: clamp(2.6rem, 5vw, 3.4rem);
    margin: 0;
    padding-top: clamp(0.5rem, 1.5vw, 1rem);
  }
  figcaption span {
    position: absolute;
    top: clamp(0.5rem, 1.5vw, 1rem);
    transform: translateX(-50%);
    width: min(26vw, 220px);
    color: #ffffff;
    font-family: var(--campaign);
    font-size: clamp(0.85rem, 1.75vw, 1.2rem);
    font-weight: 500;
    line-height: 1.15;
    text-align: center;
  }
</style>
