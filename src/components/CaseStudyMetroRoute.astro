---
interface Props {
  items: string[];
}

const { items } = Astro.props;
const stations = [
  { x: 100, y: 270, side: 'above' },
  { x: 220, y: 170, side: 'below' },
  { x: 360, y: 170, side: 'above' },
  { x: 445, y: 85, side: 'below' },
  { x: 610, y: 85, side: 'above' },
  { x: 695, y: 170, side: 'below' },
  { x: 835, y: 170, side: 'above' },
];
---

<div class="case-metro-route">
  <svg viewBox="0 0 1000 340" role="img" aria-label="One metro-style route connecting different moments in a daily journey">
    <path d="M0 270 H120 L220 170 H360 L445 85 H610 L695 170 H835 L935 270 H1000" />
    {stations.map((station) => <circle cx={station.x} cy={station.y} r="10" />)}
  </svg>
  <ul>
    {items.map((item, index) => {
      const station = stations[index];
      return (
        <li class={station.side} style={`--x:${station.x / 10}%;--y:${(station.y / 340) * 100}%`}>
          {item}
        </li>
      );
    })}
  </ul>
</div>

<style>
  .case-metro-route {
    position: relative;
    min-height: 340px;
    margin-top: clamp(2.5rem, 6vw, 5rem);
    overflow: hidden;
  }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  path {
    fill: none;
    stroke: var(--case-red);
    stroke-width: 16;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1400;
    stroke-dashoffset: 1400;
    animation: case-metro-route-draw 1.25s ease-out forwards;
  }
  circle {
    fill: var(--case-paper);
    stroke: var(--case-red);
    stroke-width: 6;
  }
  ul { position: absolute; inset: 0; z-index: 1; margin: 0; padding: 0; list-style: none; }
  li {
    position: absolute;
    left: var(--x);
    top: var(--y);
    max-width: 8rem;
    padding: 0.2rem 0.35rem;
    background: var(--case-paper);
    color: var(--case-ink);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
  }
  li.above { transform: translate(-50%, calc(-100% - 1.2rem)); }
  li.below { transform: translate(-50%, 1.2rem); }
  @keyframes case-metro-route-draw { to { stroke-dashoffset: 0; } }
  @media (max-width: 600px) {
    .case-metro-route { min-height: 280px; }
    path { stroke-width: 12; }
    circle { r: 8px; stroke-width: 5; }
    li { max-width: 5.5rem; font-size: 9px; white-space: normal; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    path { animation: none; stroke-dashoffset: 0; }
  }
</style>
