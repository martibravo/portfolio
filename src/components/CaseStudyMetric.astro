---
interface Props {
  value: string;
  label: string;
  detail?: string;
  source?: string;
  accent?: 'red' | 'yellow' | 'blue';
}

const { value, label, detail, source, accent = 'red' } = Astro.props;
---

<div class:list={['case-metric', `accent-${accent}`]}>
  <p class="case-metric-value">{value}</p>
  <p class="case-metric-label">{label}</p>
  {detail && <p class="case-metric-detail">{detail}</p>}
  {source && <p class="case-source">{source}</p>}
</div>
