---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  items: Stat[];
}

const { items } = Astro.props;
---

<div class="case-stats" aria-label="Key gender figures">
  <svg viewBox="0 0 1200 360" aria-hidden="true">
    <path d="M0 180 H100 L180 100 H1020 L1100 180 L1020 260 H180 L100 180 H0" />
  </svg>
  {items.map(item => (
    <div class="case-stat">
      <strong>{item.value}</strong>
      <span>{item.label}</span>
    </div>
  ))}
</div>
