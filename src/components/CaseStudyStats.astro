---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  items: Stat[];
}

const { items } = Astro.props;
---

<div class="case-stats" aria-label="Key gender figures">
  <svg viewBox="0 0 1200 300" aria-hidden="true">
    <path d="M0 180 H260 L320 120 H720 L780 180 H1200" />
  </svg>
  {items.map(item => (
    <div class="case-stat">
      <strong>{item.value}</strong>
      <span>{item.label}</span>
    </div>
  ))}
</div>
