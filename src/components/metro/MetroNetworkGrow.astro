---
/* Block 3: the 2030 diagram, rebuilt from the map's own vector artwork.
   Each line is split into what already ran on the 2020 map and what the 2030
   map adds; switching to 2030 draws the additions out from where they join. */
import network from '../../data/metro/network.json';
import { COLOR, INK } from './lines';

const VB = { x: 70, y: 70, w: 1790, h: 930 };
const { lines, termini } = network;
const pct = (v: number, o: number, s: number) => `${(((v - o) / s) * 100).toFixed(2)}%`;
const growth = Math.round((1 / (1 - network.newShare) - 1) * 100);
const extended = new Set(lines.filter((l) => l.pieces.some((p) => p.new)).map((l) => l.id));
---

<figure class="grow" data-reveal data-grow data-state="2020">
  <div class="grow-head">
    <div class="year-switch" role="group" aria-label="Show the network in">
      <button type="button" data-year="2020" aria-pressed="true">2020</button>
      <button type="button" data-year="2030" aria-pressed="false">2030</button>
      <span class="thumb" aria-hidden="true"></span>
    </div>
    <p class="hint">Switch years to watch the extensions grow.</p>
  </div>

  <div class="grow-map">
    <svg viewBox={`${VB.x} ${VB.y} ${VB.w} ${VB.h}`} role="img" aria-label="Barcelona metro network diagram. In 2030 mode, the extensions added since 2020 are drawn in: L1 to El Prat and Estació de Sant Adrià, L2 to Aeroport T1, L3 to Sant Feliu and Trinitat Vella, L4 to La Sagrera, L8 to Parc del Besòs, L10 to Pratenc, L12 to Finestrelles, and the L9/L10 central section.">
      {lines.map((line, li) => (
        <g class="line" data-line={line.id} style={`--c:${line.color};--i:${li}`}>
          {line.pieces.map((p) => (
            <path class:list={['piece', { ext: p.new }]} d={p.d} pathLength="1" />
          ))}
        </g>
      ))}
      {termini.map((t, i) => (
        <g class="terminus" data-line={t.line} style={`--c:${COLOR[t.line]};--d:${i * 90}ms`}>
          <circle class="pulse" cx={t.x} cy={t.y} r="16" />
          <circle class="dot" cx={t.x} cy={t.y} r="9" />
        </g>
      ))}
    </svg>
  </div>

  <div class="grow-foot">
    <ul class="stats" aria-label="What the 2030 map adds">
      <li><b>+{growth}%</b><span>more line drawn than on the 2020 map</span></li>
      <li><b>{termini.length}</b><span>new line ends</span></li>
      <li><b>{extended.size}</b><span>lines extended, L9/L10’s missing middle included</span></li>
    </ul>
    <ul class="termini" aria-label="New line ends on the 2030 map">
      {termini.map((t) => (
        <li><button type="button" data-line={t.line} style={`--c:${COLOR[t.line]};--ink:${INK[t.line]}`}><span class="bullet">{t.line}</span>{t.name}</button></li>
      ))}
    </ul>
  </div>
  <figcaption>Redrawn from the vector artwork of the 2030 map. What counts as “new” comes from comparing it with the 2020 edition, line by line. Originals: <a class="orig" href="/images/graphic-design/metro/network-2020.webp" target="_blank" rel="noopener">2020</a> · <a class="orig" href="/images/graphic-design/metro/network-2030.webp" target="_blank" rel="noopener">2030</a> · <a class="orig" href="/images/graphic-design/metro/network-2033.webp" target="_blank" rel="noopener">2030 variant</a> ↗</figcaption>
</figure>

<style>
  .grow { margin:2.5rem 0 0; }
  .grow-head { display:flex; align-items:center; gap:1.25rem; flex-wrap:wrap; margin-bottom:1rem; }
  .hint { color:var(--muted); font-size:.875rem; margin:0; }
  .year-switch { position:relative; display:inline-grid; grid-template-columns:1fr 1fr; background:var(--hover-bg); border-radius:999px; padding:4px; }
  .year-switch button { position:relative; z-index:1; border:0; background:none; font:inherit; font-weight:700; font-size:1.125rem; padding:.45rem 1.4rem; border-radius:999px; color:var(--muted); cursor:pointer; transition:color .3s; }
  .year-switch button[aria-pressed="true"] { color:var(--bg); }
  .year-switch .thumb { position:absolute; top:4px; bottom:4px; left:4px; width:calc(50% - 4px); border-radius:999px; background:var(--fg); transition:transform .45s cubic-bezier(.6,-.3,.3,1.4); }
  .grow[data-state="2030"] .thumb { transform:translateX(100%); }
  .grow-map { background:var(--hover-bg); border-radius:20px; padding:clamp(.75rem,2vw,1.5rem); overflow:hidden; }
  svg { display:block; width:100%; height:auto; overflow:visible; }
  .piece { fill:none; stroke:var(--c); stroke-width:8; stroke-linecap:round; stroke-linejoin:round; stroke-dasharray:1; stroke-dashoffset:0; transition:stroke-dashoffset 1.4s cubic-bezier(.5,0,.2,1) calc(var(--i) * 70ms), opacity .25s; }
  .ext { stroke-dashoffset:1; }
  .grow[data-state="2030"] .ext { stroke-dashoffset:0; }
  .grow[data-state="2020"] .ext { transition-duration:.6s; transition-delay:0s, 0s; }
  .terminus { opacity:0; transform-box:fill-box; transform-origin:center; transition:opacity .3s; }
  .terminus .dot { fill:var(--bg); stroke:var(--c); stroke-width:5; }
  .terminus .pulse { fill:var(--c); opacity:.25; transform-box:fill-box; transform-origin:center; }
  .grow[data-state="2030"] .terminus { opacity:1; transition-delay:calc(1.1s + var(--d)); }
  .grow[data-state="2030"] .terminus .pulse { animation:pulse 2.4s ease-out infinite calc(1.1s + var(--d)); }
  @keyframes pulse { 0% { transform:scale(.6); opacity:.45; } 100% { transform:scale(2.2); opacity:0; } }
  /* highlight a single line from the termini list */
  .grow[data-focus] .line:not(.focus) .piece { opacity:.18; }
  .grow[data-focus] .terminus:not(.focus) { opacity:.15; }
  /* first reveal: every line draws itself */
  .grow[data-armed]:not([data-inview]) .piece:not(.ext) { stroke-dashoffset:1; }

  .grow-foot { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.3fr); gap:2rem; margin-top:1.5rem; align-items:start; }
  .stats { list-style:none; padding:0; margin:0; display:grid; gap:.75rem; }
  .stats li { display:flex; align-items:baseline; gap:.9rem; border-top:1px solid var(--border); padding-top:.75rem; }
  .stats b { font-size:clamp(2rem,4vw,2.75rem); letter-spacing:-.04em; line-height:1; min-width:4.2ch; font-variant-numeric:tabular-nums; }
  .stats span { color:var(--muted); font-size:.875rem; line-height:1.35; }
  .termini { list-style:none; padding:0; margin:0; display:flex; flex-wrap:wrap; gap:.5rem; }
  .termini button { display:inline-flex; align-items:center; gap:.5rem; border:1px solid var(--border); background:var(--bg); color:var(--fg); border-radius:999px; padding:.3rem .8rem .3rem .3rem; font:inherit; font-size:.8125rem; cursor:pointer; transition:transform .2s, border-color .2s; }
  .termini button:hover, .termini button:focus-visible { transform:translateY(-2px); border-color:var(--c); }
  .bullet { display:inline-grid; place-items:center; min-width:2.1em; height:1.6em; padding:0 .25em; background:var(--c); color:var(--ink); font-weight:700; font-size:.75rem; border-radius:4px; }
  figcaption { margin-top:1rem; }
  @media (max-width:700px) { .grow-foot { grid-template-columns:1fr; } }
  @media (prefers-reduced-motion:reduce) { .piece, .ext, .terminus, .thumb { transition:none !important; } .terminus .pulse { animation:none !important; } }
</style>

<script>
  import { onReveal } from './reveal';
  function initGrow() {
    document.querySelectorAll<HTMLElement>('[data-grow]:not([data-initialized])').forEach((fig) => {
      fig.dataset.initialized = '';
      const buttons = fig.querySelectorAll<HTMLButtonElement>('[data-year]');
      let touched = false;
      const set = (year: string) => {
        fig.dataset.state = year;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.year === year)));
      };
      buttons.forEach((b) => b.addEventListener('click', () => { touched = true; set(b.dataset.year!); }));
      // Autoplay once: draw 2020, pause, then grow into 2030.
      onReveal(fig, () => { setTimeout(() => { if (!touched) set('2030'); }, 2200); });
      fig.querySelectorAll<HTMLButtonElement>('.termini button').forEach((b) => {
        const on = () => {
          fig.dataset.focus = b.dataset.line;
          fig.querySelectorAll(`[data-line]`).forEach((el) => el.classList.toggle('focus', (el as HTMLElement).dataset.line === b.dataset.line));
          if (fig.dataset.state !== '2030') { touched = true; set('2030'); }
        };
        const off = () => { delete fig.dataset.focus; fig.querySelectorAll('.focus').forEach((el) => el.classList.remove('focus')); };
        b.addEventListener('mouseenter', on); b.addEventListener('focus', on); b.addEventListener('click', on);
        b.addEventListener('mouseleave', off); b.addEventListener('blur', off);
      });
    });
  }
  initGrow();
  document.addEventListener('astro:page-load', initGrow);
</script>
