---
/* Block 14: the A3's L4 loop study. The network fades back; switching from the
   plan to the loop redraws L4 and L11 as the "L4 circular" artboard has them. */
import A3Map from './A3Map.astro';
import a3 from '../../data/metro/a3.json';
import loop from '../../data/metro/a3-loop.json';

const pick = (src: { id: string; d: string; color: string }[], id: string) => src.find((l) => l.id === id)!;
const plan = { L4: pick(a3.lines, 'L4'), L11: pick(a3.lines, 'L11') };
const ring = { L4: pick(loop.lines, 'L4'), L11: pick(loop.lines, 'L11') };
const names = ['Can Cuiàs', 'Trinitat', 'Nova', 'Maragall', 'Guinardó', 'La Sagrera', 'Clot', 'Llacuna', 'Verdaguer', 'Barceloneta', 'La Pau', 'Selva de Mar', 'Poblenou'];
---

<figure class="loop" data-loop data-state="plan">
  <div class="loop-head">
    <div class="seg" role="group" aria-label="Show">
      <button type="button" data-set="plan" aria-pressed="true">The plan</button>
      <button type="button" data-set="loop" aria-pressed="false">L4 as a loop</button>
    </div>
    <ul class="notes">
      <li style="--c:#fbb911"><b>L4</b><span class="p">comes down from Trinitat Nova, then loops through the Eixample and along the coast</span><span class="l">becomes a closed ring, with no branch to Trinitat Nova</span></li>
      <li style="--c:#a8d164"><b>L11</b><span class="p">ends at Trinitat Nova</span><span class="l">takes over the branch from Trinitat Nova and runs on through Maragall and Clot to Llacuna</span></li>
    </ul>
    <p class="note"><a class="orig" href="/images/graphic-design/metro/a3-l4-loop.webp" target="_blank" rel="noopener">Original artboard</a> ↗</p>
  </div>
  <div class="frame">
    <A3Map label="Detail of the A3 map showing L4 and L11. In the loop version, L4 becomes a ring and L11 extends from Trinitat Nova to Llacuna." layers={['geo', 'lines', 'names']} names={names} title={false} viewBox="930 190 660 940">
      <g class="plan">
        <path d={plan.L4.d} style="stroke:#fbb911" />
        <path d={plan.L11.d} style="stroke:#a8d164" />
      </g>
      <g class="ring">
        <path d={ring.L4.d} pathLength="1" style="stroke:#fbb911" />
        <path d={ring.L11.d} pathLength="1" style="stroke:#a8d164" />
      </g>
    </A3Map>
  </div>
</figure>

<style>
  .loop { margin:2.5rem 0 0; }
  .loop-head { display:flex; flex-wrap:wrap; gap:1rem 2rem; align-items:center; margin-bottom:1rem; }
  .seg { display:inline-flex; background:var(--hover-bg); border-radius:999px; padding:4px; }
  .seg button { border:0; background:none; font:inherit; font-weight:600; font-size:.9375rem; padding:.45rem 1rem; border-radius:999px; color:var(--muted); cursor:pointer; transition:background .3s, color .3s; }
  .seg button[aria-pressed="true"] { background:#fbb911; color:#111; }
  .note { margin:0; }
  .notes { list-style:none; margin:0; padding:0; display:grid; gap:.3rem; font-size:.875rem; }
  .notes li { display:flex; gap:.5rem; align-items:baseline; }
  .notes b { background:var(--c); color:#111; font-size:.75rem; padding:0 .35rem; border-radius:3px; }
  .notes .l { display:none; }
  .loop[data-state="loop"] .notes .p { display:none; }
  .loop[data-state="loop"] .notes .l { display:inline; animation:in .4s; }
  @keyframes in { from { opacity:0; transform:translateY(4px); } }
  .loop { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.1fr); gap:2rem; align-items:center; }
  .loop-head { flex-direction:column; align-items:flex-start; }
  .frame { border-radius:18px; overflow:hidden; }
  .frame :global([data-layer="lines"]) { opacity:.16; }
  .frame :global([data-layer="names"] text) { font-size:14px; font-weight:700; }
  .plan path, .ring path { fill:none; stroke-width:9; stroke-linejoin:round; transition:opacity .5s; }
  .ring path { stroke-dasharray:1; stroke-dashoffset:1; transition:stroke-dashoffset 1.6s cubic-bezier(.6,0,.2,1) .2s; }
  .ring path + path { transition-delay:.7s; }
  .loop[data-state="loop"] .plan path { opacity:0; }
  .loop[data-state="loop"] .ring path { stroke-dashoffset:0; }
  @media (max-width:760px) { .loop { grid-template-columns:1fr; } }
  @media (prefers-reduced-motion:reduce) { .ring path, .plan path { transition:none; } }
</style>

<script>
  function initLoop() {
    document.querySelectorAll<HTMLElement>('[data-loop]:not([data-initialized])').forEach((fig) => {
      fig.dataset.initialized = '';
      const buttons = fig.querySelectorAll<HTMLButtonElement>('[data-set]');
      buttons.forEach((b) => b.addEventListener('click', () => {
        fig.dataset.state = b.dataset.set;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      }));
    });
  }
  initLoop();
  document.addEventListener('astro:page-load', initLoop);
</script>
