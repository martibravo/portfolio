---
/* The geographic A3 map, rebuilt from the poster's vector artwork as separate
   layers: geography, lines, stations and names. Shared by the layers block
   and the L4 loop block. */
import a3 from '../../data/metro/a3.json';

interface Props { label: string; title?: boolean; layers?: string[]; names?: string[]; viewBox?: string }
const { label, title = true, layers = ['geo', 'lines', 'stations', 'names'], names, viewBox = '0 0 1920 1357' } = Astro.props;
const labels = a3.labels.filter((l) => (title || l.t !== 'metro de barcelona') && (!names || names.includes(l.t)));
const has = (k: string) => layers.includes(k);
---

<svg class="a3" viewBox={viewBox} role="img" aria-label={label}>
  <rect class="paper" width="1920" height="1357" />
  {has('geo') && <g class="layer geo" data-layer="geo">
    {a3.geo.map((g) => <path d={g.d} fill={g.fill} fill-rule={g.eo ? 'evenodd' : 'nonzero'} />)}
  </g>}
  {has('lines') && <g class="layer lines" data-layer="lines">
    {a3.lines.map((l, i) => <path class="ln" d={l.d} pathLength="1" data-line={l.id} style={`stroke:${l.color};--i:${i}`} />)}
    {a3.ticks.map((t) => <path d={t.d} fill={t.c} />)}
  </g>}
  {has('stations') && <g class="layer stations" data-layer="stations">
    {a3.black.map((d) => <path d={d} class="blk" />)}
    {a3.white.map((d) => <path d={d} class="wht" />)}
  </g>}
  {has('names') && <g class="layer names" data-layer="names">
    {!names && a3.bullets.map((b) => <rect x={b.x} y={b.y} width={b.w} height={b.h} fill={b.c} />)}
    {!names && a3.rod.map((r) => <g><rect x={r.x} y={r.y} width={r.w} height={r.w} fill="#ff6600" /><text x={r.x + r.w / 2} y={r.y + r.w * 0.8} text-anchor="middle" class="rod" style={`font-size:${r.w * 0.85}px`}>R</text></g>)}
    {labels.map((t) => (
      <text x={t.x} y={t.y} font-size={t.s} class:list={{ b: t.b, w: t.w }} transform={t.r ? `rotate(${t.r} ${t.x} ${t.y})` : undefined} data-name={t.t}>{t.t}</text>
    ))}
  </g>}
  <slot />
</svg>

<style>
  .a3 { display:block; width:100%; height:auto; font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; }
  .paper { fill:#faf9f6; }
  .ln { fill:none; stroke-width:5; stroke-linejoin:round; stroke-linecap:butt; }
  .blk { fill:#000; }
  .wht { fill:#fff; }
  text { fill:#000; font-weight:400; }
  text.b { font-weight:700; }
  text.w { fill:#fff; font-weight:700; }
  .rod { fill:#fff; font-weight:700; }
</style>
