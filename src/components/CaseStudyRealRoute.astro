---
interface Props {
  items: string[];
}

const { items } = Astro.props;

/* Path and node geometry taken straight from the campaign's own Figma export
   (route with stations). Node centres are the rotated square pivots resolved
   to their visual centres, listed here in the order the route travels. */
const ROUTE_PATH =
  'M0 513H212.735C238.196 513 262.614 523.114 280.618 541.118L438.882 699.382C456.886 717.386 481.304 727.5 506.764 727.5H831.5M831.5 727.5L1017.88 541.118C1035.89 523.114 1046 498.696 1046 473.236V198.265C1046 172.804 1056.11 148.386 1074.12 130.382L1136.62 67.8823C1174.11 30.3919 1234.89 30.3919 1272.38 67.8823L1363 158.5L1601.88 397.382C1619.89 415.386 1630 439.804 1630 465.264V627.235C1630 652.696 1619.89 677.114 1601.88 695.118L1346.12 950.882C1328.11 968.886 1303.7 979 1278.24 979H1142.26C1116.8 979 1092.39 968.886 1074.38 950.882L864.789 741.289C855.96 732.46 843.986 727.5 831.5 727.5Z';

const VIEW_W = 1669;
const VIEW_H = 1019;

const stations = [
  { x: 88, y: 512.5, side: 'above', align: 'start' },
  { x: 342, y: 605.5, side: 'below', align: 'center' },
  { x: 649, y: 727.5, side: 'below', align: 'center' },
  { x: 845, y: 727.5, side: 'above', align: 'center' },
  { x: 1116, y: 81.5, side: 'below', align: 'center' },
  { x: 1473, y: 261.5, side: 'above', align: 'center' },
  { x: 1630, y: 551.5, side: 'below', align: 'end' },
  { x: 1316, y: 979.5, side: 'above', align: 'center' },
];
---

<div class="case-real-route">
  <svg viewBox={`0 0 ${VIEW_W} ${VIEW_H}`} role="img" aria-label="One flexible route linking the stops of a single day">
    <path d={ROUTE_PATH} pathLength="1" />
    {stations.map((s) => <circle cx={s.x} cy={s.y} r="33.8" />)}
  </svg>
  <ul>
    {items.slice(0, stations.length).map((item, index) => {
      const s = stations[index];
      return (
        <li
          class:list={[s.side, `align-${s.align}`]}
          style={`--x:${(s.x / VIEW_W) * 100}%;--y:${(s.y / VIEW_H) * 100}%`}
        >
          {item}
        </li>
      );
    })}
  </ul>
</div>

<style>
  .case-real-route {
    position: relative;
    width: 100%;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  path {
    fill: none;
    stroke: var(--case-red);
    stroke-width: 24;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: case-real-route-draw 1.6s ease-out forwards;
  }
  circle {
    fill: var(--case-paper);
    stroke: var(--case-ink);
    stroke-width: 8;
  }
  ul {
    position: absolute;
    inset: 0;
    z-index: 1;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    position: absolute;
    left: var(--x);
    top: var(--y);
    padding: 0.2rem 0.45rem;
    background: var(--case-paper);
    color: var(--case-ink);
    font-family: var(--campaign);
    font-size: clamp(9px, 1.1vw, 13px);
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
  }
  li.above { margin-top: -2.3rem; }
  li.below { margin-top: 2.3rem; }
  li.align-center { transform: translate(-50%, -50%); }
  li.align-start { transform: translate(-15%, -50%); }
  li.align-end { transform: translate(-85%, -50%); }
  @keyframes case-real-route-draw {
    to { stroke-dashoffset: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    path { animation: none; stroke-dashoffset: 0; }
  }
</style>
