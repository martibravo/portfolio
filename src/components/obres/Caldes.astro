---
/* 06 · Propera estació. The opening's board and lonely ring again. The reader
   brings the train: C1, C2 and the R9 run in and meet at l'Estació. The only
   line on the page that draws itself. */
import Board from './Board.astro';
import GeoBase from './GeoBase.astro';
import geo from '../../data/metro/geo.json';
import { STOPS, COLORS } from './valles';

const S = STOPS;
const shown = [
  { p: S.sabadellPN, name: 'Sabadell Parc del Nord', side: 'l' },
  { p: S.sabadellPM, name: 'Sabadell Plaça Major', side: 'l' },
  { p: S.castellar, name: 'Castellar del Vallès', side: 'l' },
  { p: S.sentmenat, name: 'Sentmenat', side: 'd' },
  { p: S.palau, name: 'Palau-solità i Plegamans', side: 'r' },
  { p: S.canPerera, name: 'Can Perera Industrial', side: 'r' },
  { p: S.mollet, name: 'Mollet - Sta. Rosa', side: 'r' },
  { p: S.granollers, name: 'Granollers - Canovelles', side: 'l' },
];
const C = { x: S.caldes[0], y: S.caldes[1] };
---

<div class="caldes" data-caldes>
  <div class="board-wrap" data-tip="The town archive keeps a 1912 timetable for the train between Caldes and Barcelona. This is the first one in a while.">
    <Board id="board-caldes" rows={[{ a: 'Caldes de Montbui', c: 'Sense servei' }]} small="ficció" />
  </div>
  <svg viewBox="-560 -1080 1440 950" role="img" aria-label="The Vallès around Caldes de Montbui. After bringing the train, C1 runs from Sabadell through Castellar and Sentmenat, C2 runs down to Mollet, and the R9 comes from Plaça de Catalunya; all three end at Caldes de Montbui, l’Estació." data-scene>
    <GeoBase towns={['Terrassa', 'Sant Cugat', 'Montcada i Reixac', 'la Garriga']} />
    <path class="ln new r9" d={geo.R9} pathLength="1" style={`stroke:${COLORS.R9}`} data-tip="In 1888 La Maquinista built a locomotive for the Barcelona–Sarrià railway, the line the R9 runs on. It was later sold to the Mollet–Caldes line. Known today as the Caldas, it’s the oldest Spanish-built locomotive still in existence, kept at the Catalan railway museum in Vilanova i la Geltrú." />
    <path class="ln" d={geo.S2} style={`stroke:${COLORS.S2}`} />
    <path class="ln" d={geo.R3} style={`stroke:${COLORS.R3}`} />
    <path class="ln new" d={geo.C1} pathLength="1" style={`stroke:${COLORS.C1}`} />
    <path class="ln new" d={geo.C2} pathLength="1" style={`stroke:${COLORS.C2}`} />
    {shown.map((t) => (
      <g class="town"><circle cx={t.p[0]} cy={t.p[1]} r="8" /><text x={t.side === 'l' ? t.p[0] - 18 : t.side === 'u' || t.side === 'd' ? t.p[0] : t.p[0] + 18} y={t.side === 'u' ? t.p[1] - 18 : t.side === 'd' ? t.p[1] + 38 : t.p[1] + 8} text-anchor={t.side === 'l' ? 'end' : t.side === 'u' || t.side === 'd' ? 'middle' : 'start'}>{t.name}</text></g>
    ))}
    <circle class="estacio" cx={C.x} cy={C.y} r="20" data-tip="In the 1940s there were attempts to bring El Calderí back. At one point someone even tried filling the boilers with the town’s thermal water." />
    <text class="caldes-name" x={C.x + 32} y={C.y - 2}>Caldes de Montbui</text>
    <text class="caldes-sub" x={C.x + 32} y={C.y + 28}>| l’Estació</text>
    <g class="pills">
      <g transform={`translate(${C.x + 32} ${C.y - 70})`}>
        <rect width="64" height="34" rx="17" fill={COLORS.C1} /><text x="32" y="25">C1</text>
        <rect x="72" width="64" height="34" rx="17" fill={COLORS.C2} /><text x="104" y="25">C2</text>
        <rect x="144" width="44" height="34" fill={COLORS.R9} /><text x="166" y="25" class="dk">R9</text>
      </g>
    </g>
  </svg>
  <p class="osm">Map data © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors. C1, C2 and the R9 to Caldes are my proposal: C1 and the R9 use the S2 and FGC’s planned extension to Castellar, and C2 relays El Calderí’s old trackbed.</p>
  <p class="tip" data-tip-box hidden></p>
  <button type="button" class="bring" data-bring>Porta-hi el tren <span>Bring the train</span></button>
</div>

<style>
  .caldes { position:relative; margin-top:2rem; }
  .board-wrap { max-width:none; }
  svg { display:block; width:100%; height:auto; margin-top:1rem; border-radius:12px; box-shadow:0 0 0 1px #e3e0d6; }
  .ln { fill:none; stroke-width:7; stroke-linejoin:round; }
  .new { stroke-width:9; stroke-dasharray:1; stroke-dashoffset:1; }
  .r9 { stroke-width:17; }
  .caldes[data-brought] .new { stroke-dashoffset:0; transition:stroke-dashoffset var(--dur,2.4s) linear; }
  .town circle { fill:#fff; stroke:#111; stroke-width:5; }
  .town text, .caldes-name, .caldes-sub { font:700 22px var(--campaign); fill:#111; }
  .caldes-name { font-size:30px; }
  .caldes-sub { font-size:24px; font-weight:400; }
  .estacio { fill:none; stroke:#111; stroke-width:7; transition:fill .01s linear 2.4s; }
  .caldes[data-brought] .estacio { fill:#fff; stroke-width:9; }
  .pills { opacity:0; }
  .caldes[data-brought] .pills { opacity:1; transition:opacity .01s linear 2.4s; }
  .pills text { font:700 22px var(--campaign); fill:#fff; text-anchor:middle; }
  .pills text.dk { fill:#111; }
  [data-tip] { cursor:help; }
  .tip { position:absolute; max-width:22rem; margin:0; background:#fff; border:3px solid #111; padding:.55rem .7rem; font-size:.8125rem; line-height:1.4; z-index:5; pointer-events:none; }
  .osm { margin:.4rem 0 0; font-size:.6875rem; color:#777; }
  .osm a { color:inherit; }
  .bring { margin-top:1rem; display:inline-flex; flex-direction:column; align-items:flex-start; border:0; background:#111; color:#ffb300; font:700 1.1rem var(--campaign); padding:.7rem 1.2rem; border-radius:6px; cursor:pointer; text-transform:uppercase; letter-spacing:.04em; }
  .bring span { font-size:.6875rem; color:#d9c38a; letter-spacing:.08em; }
  .bring[disabled] { opacity:.5; cursor:default; }
  @media (prefers-reduced-motion:reduce) { .caldes[data-brought] .new, .estacio, .caldes[data-brought] .pills { transition:none; } }
</style>

<script>
  function initCaldes() {
    document.querySelectorAll<HTMLElement>('[data-caldes]:not([data-initialized])').forEach((root) => {
      root.dataset.initialized = '';
      const board = root.querySelector<HTMLElement>('[data-board]')!;
      const row = board.querySelector('.row')!;
      const bring = root.querySelector<HTMLButtonElement>('[data-bring]')!;
      root.querySelectorAll<SVGPathElement>('.new').forEach((p) => p.style.setProperty('--dur', `${(p.getTotalLength() / 500).toFixed(2)}s`));
      const write = (a: string, b: string, c: string) => {
        row.innerHTML = '';
        [['a', a], ['b', b], ['c', c]].forEach(([cls, txt]) => {
          const s = document.createElement('span'); s.className = cls;
          [...txt].forEach((ch) => { const f = document.createElement('span'); f.className = 'fl'; f.textContent = ch; s.append(f); });
          row.append(s);
        });
      };
      let left = 240;
      const tick = () => {
        const m = Math.floor(left / 60), s = left % 60;
        const last = row.querySelector('.c')?.textContent;
        const txt = m > 0 ? `${m} min` : `${s} s`;
        if (txt !== last) write('Caldes de Montbui', 'R9 Pl. Catalunya', txt);
        left = left > 0 ? left - 1 : 240;
      };
      bring.addEventListener('click', () => {
        root.dataset.brought = '';
        bring.disabled = true;
        setTimeout(() => { tick(); setInterval(tick, 1000); }, 2400);
      });
      // hidden details for the people who hover
      const box = root.querySelector<HTMLElement>('[data-tip-box]')!;
      root.querySelectorAll<Element>('[data-tip]').forEach((el) => {
        el.addEventListener('pointerenter', (e) => {
          box.textContent = el.getAttribute('data-tip'); box.hidden = false;
          const r = root.getBoundingClientRect(); const pe = e as PointerEvent;
          box.style.left = `${Math.min(pe.clientX - r.left + 12, r.width - 360)}px`;
          box.style.top = `${pe.clientY - r.top + 12}px`;
        });
        el.addEventListener('pointerleave', () => { box.hidden = true; });
      });
    });
  }
  initCaldes();
  document.addEventListener('astro:page-load', initCaldes);
</script>
