---
/* A platform departure board. Rows can be re-written from script; changed
   characters flip. */
interface Props { rows: { a: string; b?: string; c?: string }[]; id?: string; small?: string }
const { rows, id, small } = Astro.props;
---

<div class="board" data-board id={id} lang="ca">
  {rows.map((r) => (
    <p class="row"><span class="a">{r.a}</span>{r.b && <span class="b">{r.b}</span>}{r.c && <span class="c">{r.c}</span>}</p>
  ))}
  {small && <p class="small">{small}</p>}
</div>

<style>
  .board { background:#141414; color:#ffb300; border-radius:6px; padding:.9rem 1.5rem .9rem 1.1rem; font-family:var(--campaign); font-weight:700; text-transform:uppercase; letter-spacing:.04em; box-shadow:inset 0 0 0 3px #2a2a2a; font-variant-numeric:tabular-nums; }
  .row { display:flex; flex-wrap:wrap; gap:.2rem 1.5rem; justify-content:space-between; margin:0; font-size:clamp(1rem,2.4vw,1.5rem); line-height:1.35; }
  .row + .row { margin-top:.2rem; }
  .row > :global(span) { white-space:nowrap; }
  .row :global(.b) { color:#fff4d6; }
  .row :global(.c) { margin-left:auto; }
  .small { margin:.4rem 0 0; font-size:.6875rem; color:#b98a1c; letter-spacing:.08em; }
  .board :global(.fl) { display:inline-block; white-space:pre; animation:flip .35s steps(3,end) both; }
  @keyframes flip { 0% { transform:scaleY(1); } 50% { transform:scaleY(.1); } 100% { transform:scaleY(1); } }
  @media (prefers-reduced-motion:reduce) { .board :global(.fl) { animation:none; } }
</style>
