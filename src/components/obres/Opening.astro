---
/* 00 · Sense servei. A board with no trains in Caldes; the first scroll is the
   page's only camera move, ~30 km south until Barcelona's network fills the
   screen, trains running on real service hours. */
import Board from './Board.astro';
import a3 from '../../data/metro/a3.json';
import { TOWNS, S2, R3, COLORS, VB_CALDES, VB_BCN } from './valles';

const lines = a3.lines;
const life = [
  { y: '1880', t: 'El Calderí opens' },
  { y: '1932', t: 'Service stops: lorries carry the granite now, and Sagalés runs buses to Barcelona' },
  { y: '1937', t: 'Back, for the war' },
  { y: '1939', t: 'The last train' },
  { y: '1959', t: 'Sagalés takes over the company holding the railway’s rights; the station grounds become a bus park' },
  { y: '1960', t: 'The tracks come up' },
  { y: '1980', t: 'The station building is knocked down, still structurally sound' },
  { y: '1981', t: 'Parc de l’Estació opens, after the town campaigned for it', end: true },
];
const towns = [TOWNS.sabadellPN, TOWNS.mollet, TOWNS.granollers];
---

<section id="sense-servei" class="opening">
  <p class="page-title"><span lang="ca">Estat de les obres</span> <span class="tr">State of the works</span></p>
  <Board id="board-open" rows={[{ a: 'Caldes de Montbui', c: 'Sense servei' }]} small="No service · Sin servicio" />
  <p class="strip">Metro Map 2040 · Case study · 2020–2026 · Cartography, data, code · Used by the <a href="https://www.diaridebarcelona.cat/w/linia9-metro-mai-arriba">Diari de Barcelona</a>, 2024</p>

  <div class="cam" data-cam>
    <div class="cam-copy">
      <h2>Caldes de Montbui has been waiting for a train since 1939.</h2>
      <p>It had one once. El Calderí ran about fifteen kilometres down to Mollet, on and off, from 1880 until Franco’s troops reached the town in January 1939. It never came back.</p>
      <p>I grew up in a flat on the old station grounds. From my window I could see where the trains used to stop.</p>
      <p>Growing up, I looked at that missing station a lot. Barcelona was where I wanted to be, and there was no train to get there.</p>
      <p>At 19 I started drawing Barcelona’s metro. It turned out I loved the system as much as the way out. I haven’t stopped.</p>

      <ol class="life" aria-label="The station’s own line, 1880 to 1981">
        {life.map((s) => (
          <li class:list={{ end: s.end }}><b>{s.y}</b><span>{s.t}</span></li>
        ))}
      </ol>
      <p class="life-name">Parc de l’Estació</p>
      <div class="spacer" aria-hidden="true"></div>
    </div>

    <div class="cam-stage">
      <svg viewBox={VB_CALDES.join(' ')} data-cam-svg role="img" aria-label="Map starting on Caldes de Montbui, with the S2 ending at Sabadell and the R3 passing through Mollet and Granollers, and an empty station ring at Caldes. Scrolling moves south until Barcelona’s metro network fills the view.">
        <rect x="-2000" y="-3000" width="6000" height="6000" fill="#faf9f6" />
        <use href="#a3-geo" />
        <g class="lines">{lines.map((l) => <path d={l.d} style={`stroke:${l.color}`} data-line={l.id} />)}</g>
        <use href="#a3-ticks" /><use href="#a3-stations" /><use href="#a3-names-bold" />
        <g class="valles">
          <path d={S2} style={`stroke:${COLORS.S2}`} />
          <path d={R3} style={`stroke:${COLORS.R3}`} />
          <path class="bar" d="M740 -800 H780" style={`stroke:${COLORS.S2}`} />
          {towns.map((t) => (
            <g class="town"><circle cx={t.x} cy={t.y} r="9" /><text x={t.side === 'l' ? t.x - 22 : t.x + 22} y={t.y + 9} text-anchor={t.side === 'l' ? 'end' : 'start'}>{t.name}</text></g>
          ))}
          <circle class="lonely" cx={TOWNS.caldes.x} cy={TOWNS.caldes.y} r="26" />
          <text class="caldes" x={TOWNS.caldes.x + 44} y={TOWNS.caldes.y + 14}>Caldes de Montbui</text>
          <text class="dir" x="1712" y="-1440">R3 → Vic</text>
        </g>
        <g class="trains" data-trains></g>
      </svg>
      <p class="closed" data-closed hidden><span lang="ca">El metro obre a les 05:00.</span></p>
    </div>
  </div>
</section>

<style>
  .opening { padding-top:2rem; }
  .page-title { margin:0 0 1rem; font-weight:700; font-size:.875rem; }
  .page-title .tr, .strip { color:#666; font-weight:400; }
  .strip { font-size:.8125rem; margin:.75rem 0 0; }
  .strip a { color:inherit; }
  .cam { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.5fr); gap:clamp(1.5rem,4vw,3.5rem); margin-top:clamp(2rem,6vw,4rem); }
  .cam-copy h2 { font-size:clamp(1.9rem,4vw,3rem); line-height:1.05; letter-spacing:-.04em; margin:0 0 1.5rem; font-weight:600; }
  .cam-copy p { margin:0 0 1rem; max-width:42ch; }
  .spacer { height:60vh; }
  .cam-stage { position:sticky; top:4.5rem; height:calc(100vh - 6rem); align-self:start; }
  .cam-stage svg { width:100%; height:100%; display:block; border-radius:16px; }
  .lines path { fill:none; stroke-width:5; stroke-linejoin:round; }
  .valles path { fill:none; stroke-width:9; stroke-linejoin:round; }
  .valles .bar { stroke-width:10; }
  .town circle { fill:#fff; stroke:#111; stroke-width:5; }
  .town text, .caldes, .dir { font-family:var(--campaign); font-size:30px; font-weight:700; fill:#111; }
  .dir { font-size:24px; fill:#c8202f; }
  .caldes { font-size:40px; }
  .lonely { fill:none; stroke:#111; stroke-width:7; }
  .trains :global(circle) { stroke:#fff; stroke-width:2.5; }
  .closed { position:absolute; left:1rem; bottom:1rem; margin:0; background:#141414; color:#ffb300; font-weight:700; font-size:.8125rem; padding:.3rem .7rem; border-radius:4px; }
  .life { list-style:none; padding:0 0 0 1.6rem; margin:2rem 0 0; position:relative; }
  .life::before { content:''; position:absolute; left:6px; top:.5rem; bottom:.2rem; width:6px; background:#111; border-radius:3px; }
  .life li { position:relative; display:grid; grid-template-columns:3.2rem 1fr; gap:.5rem; font-size:.875rem; line-height:1.35; margin-bottom:.7rem; }
  .life li::before { content:''; position:absolute; left:-1.1rem; top:.5rem; width:10px; height:4px; background:#111; }
  .life li.end::before { left:calc(-1.6rem - 2px); top:.1rem; width:14px; height:14px; border-radius:50%; background:#fff; border:4px solid #111; }
  .life b { font-variant-numeric:tabular-nums; }
  .life-name { font-weight:700; margin:.2rem 0 0 1.6rem; }
  @media (max-width:820px) {
    .cam { grid-template-columns:1fr; }
    .cam-stage { grid-row:1; height:55vh; top:3.5rem; z-index:2; }
    .cam-copy { background:#faf9f6; position:relative; z-index:1; }
  }
</style>

<script>
  import { VB_CALDES, VB_BCN } from './valles';
  /* Barcelona service hours: Mon–Thu and Sun 05:00–24:00, Fri 05:00–02:00,
     Sat all night. Europe/Madrid, whatever the reader's timezone. */
  function inService(now = new Date()) {
    const parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Madrid', weekday: 'short', hour: 'numeric', hour12: false }).formatToParts(now);
    const day = parts.find((p) => p.type === 'weekday')!.value;
    const h = Number(parts.find((p) => p.type === 'hour')!.value) % 24;
    if (h >= 5) return true;
    if (day === 'Sun') return true;             // Saturday runs all night
    if (day === 'Sat') return h < 2;            // Friday runs until 02:00
    return false;
  }

  function initOpening() {
    const cam = document.querySelector<HTMLElement>('[data-cam]:not([data-initialized])');
    if (!cam) return;
    cam.dataset.initialized = '';
    const svg = cam.querySelector<SVGSVGElement>('[data-cam-svg]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // camera: scroll through the copy column tweens the viewBox Caldes → Barcelona
    const ease = (t: number) => t * t * (3 - 2 * t);
    const camera = () => {
      const r = cam.getBoundingClientRect();
      const span = r.height - innerHeight;
      const p = ease(Math.min(1, Math.max(0, (-r.top + innerHeight * 0.15) / Math.max(1, span * 0.75))));
      const vb = VB_CALDES.map((v, i) => v + (VB_BCN[i] - v) * p);
      svg.setAttribute('viewBox', vb.join(' '));
    };
    addEventListener('scroll', camera, { passive: true });
    camera();

    // trains: dots on every line, spaced by headway, at a scaled speed
    const open = inService();
    cam.querySelector<HTMLElement>('[data-closed]')!.hidden = open;
    const layer = svg.querySelector('[data-trains]')!;
    const NS = 'http://www.w3.org/2000/svg';
    const trains = [...svg.querySelectorAll<SVGPathElement>('.lines path')].flatMap((path) => {
      const len = path.getTotalLength();
      const n = Math.max(2, Math.round(len / 420));
      return Array.from({ length: n }, (_, i) => {
        const c = document.createElementNS(NS, 'circle');
        c.setAttribute('r', '7');
        c.setAttribute('fill', getComputedStyle(path).stroke);
        layer.append(c);
        return { c, path, len, off: (i / n) * len * 2, dir: i % 2 };
      });
    });
    const place = (tm: number) => {
      const SPEED = 48;   // map units a second: ~1 real minute per second
      trains.forEach((t) => {
        let d = open ? (t.off + tm * SPEED) % (t.len * 2) : t.off % (t.len * 2);
        if (d > t.len) d = 2 * t.len - d;      // run back from the terminus
        if (!open) d = t.dir ? 0 : t.len;      // parked at the termini
        const p = t.path.getPointAtLength(d);
        t.c.setAttribute('cx', p.x.toFixed(1)); t.c.setAttribute('cy', p.y.toFixed(1));
      });
    };
    place(0);
    if (reduce || !open) return;
    let visible = false;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(svg);
    const t0 = performance.now();
    const loop = (now: number) => { if (visible) place((now - t0) / 1000); requestAnimationFrame(loop); };
    requestAnimationFrame(loop);
  }
  initOpening();
  document.addEventListener('astro:page-load', initOpening);
</script>
