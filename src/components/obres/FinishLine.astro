---
/* 03c · The finish line kept moving. One column per station, a dot at its
   promised year. The reader drags the calendar up; the dots jump when an
   edition changes them. */
import { EDITIONS, YEARS, CHART_STATIONS } from '../../data/metro/obres';

const dated = EDITIONS.filter((e) => e.t != null);
const idx = (e: (typeof dated)[number]) => EDITIONS.indexOf(e);
const Y0 = 2022, Y1 = 2031;
const W = 900, H = 440, L = 70, R = 20, TOP = 20, B = 120;
const x = (i: number) => L + ((i + 0.5) / CHART_STATIONS.length) * (W - L - R);
const y = (yr: number) => TOP + ((Y1 - yr) / (Y1 - Y0)) * (H - TOP - B);
const payload = {
  eds: dated.map((e) => ({ t: e.t, label: e.label, years: CHART_STATIONS.map((s) => Number(YEARS[s][idx(e)])) })),
  y0: Y0, y1: Y1, top: TOP, h: H - TOP - B,
};
const first = payload.eds[0];
const notes: Record<string, string> = {
  'Jul 2024': 'Santander: not started. Due 2024.',
  'Dec 2024': 'Every date: 2028.',
  'Jun 2025': 'Motors: 2028 in all eight editions. The only date that never moved.',
};
---

<figure class="finish" data-finish>
  <script type="application/json" data-payload set:html={JSON.stringify({ ...payload, notes })} />
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Promised opening year for fourteen L9/L10 stations, edition by edition, against the date of each edition.">
    {Array.from({ length: Y1 - Y0 + 1 }, (_, k) => Y0 + k).map((yr) => (
      <g class="grid"><line x1={L} x2={W - R} y1={y(yr)} y2={y(yr)} /><text x={L - 12} y={y(yr) + 5}>{yr}</text></g>
    ))}
    <g class="calendar" data-cal style={`transform:translateY(${y(first.t!)}px)`}>
      <rect x={L} y="0" width={W - L - R} height={H - B - y(first.t!)} data-past />
      <line x1={L} x2={W - R} y1="0" y2="0" />
      <text x={W - R} y="-8" text-anchor="end" data-cal-label>{first.label}</text>
    </g>
    {CHART_STATIONS.map((s, i) => (
      <g class="col">
        <line x1={x(i)} x2={x(i)} y1={TOP} y2={H - B} />
        <circle data-dot={i} cx={x(i)} cy={y(first.years[i])} r="9" style={`transform:translateY(0)`} />
        <text transform={`translate(${x(i) + 4} ${H - B + 14}) rotate(50)`}>{s}</text>
      </g>
    ))}
  </svg>
  <div class="scrub">
    <label for="finish-range">Drag the calendar</label>
    <input id="finish-range" type="range" min={Math.round(dated[0].t! * 100)} max={Math.round(dated[dated.length - 1].t! * 100)} value={Math.round(dated[0].t! * 100)} step="1" data-range />
    <output data-out>{first.label}</output>
  </div>
  <p class="note" data-note aria-live="polite"></p>
  <p class="aside">Lesseps: 92% done since my first edition.</p>
</figure>

<style>
  .finish { margin:2rem 0 0; background:#fff; padding:1rem 1rem 1.25rem; border-radius:12px; }
  svg { display:block; width:100%; height:auto; font-family:var(--campaign); }
  .grid line { stroke:#e7e3d8; }
  .grid text { font-size:13px; fill:#777; text-anchor:end; font-variant-numeric:tabular-nums; }
  .col line { stroke:#f0ede4; }
  .col text { font-size:12px; font-weight:700; fill:#333; }
  .col circle { fill:#111; stroke:#fff; stroke-width:3; transition:cy .25s steps(4,end), fill .2s; }
  .col circle.late { fill:#e32739; }
  .calendar line { stroke:#e32739; stroke-width:3; }
  .calendar rect { fill:#e3273912; }
  .calendar text { fill:#e32739; font-size:13px; font-weight:700; }
  .scrub { display:grid; grid-template-columns:auto 1fr auto; gap:1rem; align-items:center; margin-top:.5rem; font-size:.8125rem; }
  input { accent-color:#e32739; }
  output { font-weight:700; font-variant-numeric:tabular-nums; min-width:5.5em; }
  .note { min-height:1.4em; font-weight:700; margin:.6rem 0 0; }
  .aside { margin:.2rem 0 0; font-size:.8125rem; color:#666; }
  @media (prefers-reduced-motion:reduce) { .col circle { transition:none; } }
</style>

<script>
  function initFinish() {
    document.querySelectorAll<HTMLElement>('[data-finish]:not([data-initialized])').forEach((fig) => {
      fig.dataset.initialized = '';
      const D = JSON.parse(fig.querySelector('[data-payload]')!.textContent!);
      const range = fig.querySelector<HTMLInputElement>('[data-range]')!;
      const cal = fig.querySelector<SVGGElement>('[data-cal]')!;
      const past = fig.querySelector<SVGRectElement>('[data-past]')!;
      const dots = [...fig.querySelectorAll<SVGCircleElement>('[data-dot]')];
      const Y = (yr: number) => D.top + ((D.y1 - yr) / (D.y1 - D.y0)) * D.h;
      const update = () => {
        const t = Number(range.value) / 100;
        let e = D.eds[0];
        for (const ed of D.eds) if (ed.t <= t + 1e-6) e = ed;
        cal.style.transform = `translateY(${Y(t)}px)`;
        past.setAttribute('height', String(Math.max(0, D.top + D.h - Y(t))));
        fig.querySelector('[data-cal-label]')!.textContent = e.label;
        fig.querySelector('[data-out]')!.textContent = e.label;
        dots.forEach((d, i) => {
          d.style.cy = `${Y(e.years[i])}px`;
          d.classList.toggle('late', e.years[i] <= t);
        });
        fig.querySelector('[data-note]')!.textContent = D.notes[e.label] ?? '';
      };
      range.addEventListener('input', update);
      update();
    });
  }
  initFinish();
  document.addEventListener('astro:page-load', initFinish);
</script>
