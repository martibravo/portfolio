---
/* 01 · En servei. The TMB-style map as it ran in 2020, with an X-ray loupe
   that shows the construction underneath: grid, centrelines, stroke and gap
   dimensions, bend angles. */
import network from '../../data/metro/network.json';
import { LINES } from '../metro/lines';

const W = 2414, H = 1196;
const pts = (d: string) => [...d.matchAll(/(-?\d+\.?\d*) (-?\d+\.?\d*)/g)].map((m) => [Number(m[1]), Number(m[2])]);
const old = network.lines.map((l) => ({ id: l.id, color: l.color, pieces: l.pieces.filter((p) => !p.new).map((p) => p.d) }));

// Find a few real bends to annotate: horizontal or vertical into 45°.
const bends: { x: number; y: number; a0: number; a1: number }[] = [];
for (const l of old) {
  for (const d of l.pieces) {
    const p = pts(d);
    for (let i = 1; i < p.length - 1 && bends.length < 5; i++) {
      const a0 = Math.atan2(p[i][1] - p[i - 1][1], p[i][0] - p[i - 1][0]);
      const a1 = Math.atan2(p[i + 1][1] - p[i][1], p[i + 1][0] - p[i][0]);
      const seg = Math.hypot(p[i + 1][0] - p[i][0], p[i + 1][1] - p[i][1]);
      const turn = Math.abs(((a1 - a0 + 3 * Math.PI) % (2 * Math.PI)) - Math.PI);
      if (seg > 60 && Math.abs(turn - Math.PI / 4) < 0.05 && !bends.some((b) => Math.hypot(b.x - p[i][0], b.y - p[i][1]) < 400)) {
        bends.push({ x: p[i][0], y: p[i][1], a0, a1 });
      }
    }
  }
}
const arc = (b: (typeof bends)[number], r = 34) => {
  const s = [b.x + r * Math.cos(b.a0), b.y + r * Math.sin(b.a0)];
  const e = [b.x + r * Math.cos(b.a1), b.y + r * Math.sin(b.a1)];
  return `M${b.x} ${b.y} L${s[0].toFixed(1)} ${s[1].toFixed(1)} A${r} ${r} 0 0 1 ${e[0].toFixed(1)} ${e[1].toFixed(1)} Z`;
};
const rules = [
  'Lines run at 0°, 45° or 90°. Nothing else.',
  'Every line is 8 px wide. Parallel lines sit 8.5 px apart, centre to centre: they touch, round the corners too.',
  'A station tick points at its label.',
  'A ring is one station. A capsule is a walk between two.',
  'A terminus is a bar across the line, with the name in the line’s colour.',
  'Labels never cross a line.',
];
---

<section id="en-servei" class="block">
  <p class="tag">En servei <span>In service</span></p>
  <h2>First, I copied.</h2>
  <div class="copy">
    <p>Before I had opinions about the network, I wanted its handwriting. I redrew the official map until mine and theirs were hard to tell apart, down to the legend panel and the footer in three languages.</p>
    <p>Three angles: 0°, 45°, 90°. A tick points at its station’s name. A capsule means you’ll be walking down a corridor. Twelve colours, and not one more.</p>
    <p>It’s the least original work on this page. Everything else stands on it.</p>
  </div>

  <figure class="xray" data-xray>
    <div class="xray-bar">
      <button type="button" data-all aria-pressed="false">Show the rules</button>
      <span class="hint">Move the loupe over the map.</span>
      <a class="orig" href="/images/graphic-design/metro/network-2020.webp" target="_blank" rel="noopener">See the original ↗</a>
    </div>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Barcelona metro network as it ran in 2020, redrawn in the style of the official TMB map. The loupe reveals the construction: grid, centrelines, stroke widths and bend angles." data-xray-svg>
      <defs>
        <pattern id="xr-grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M0 0H40M0 0V40M0 40L40 0M0 0L40 40" stroke="#317bc8" stroke-width=".7" opacity=".35" fill="none" />
        </pattern>
        <mask id="xr-mask" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
          <rect width={W} height={H} fill="#000" />
          <circle data-loupe cx="-500" cy="-500" r="190" fill="#fff" />
        </mask>
      </defs>
      <image href="/images/graphic-design/metro/network-2020.webp" width={W} height={H} />
      <g class="focus-layer">
        <rect width={W} height={H} fill="#faf9f6" opacity=".82" />
        {old.map((l) => <g data-fline={l.id}>{l.pieces.map((d) => <path d={d} style={`stroke:${l.color}`} />)}</g>)}
      </g>
      <g class="construction" mask="url(#xr-mask)">
        <rect width={W} height={H} fill="#fbfaf5" />
        <rect width={W} height={H} fill="url(#xr-grid)" />
        {old.map((l) => l.pieces.map((d) => <><path class="hull" d={d} /><path class="cl" d={d} /></>))}
        {bends.map((b) => <><path class="arc" d={arc(b)} /><g class="dim"><rect x={b.x + 30} y={b.y - 44} width="58" height="30" /><text x={b.x + 59} y={b.y - 22}>45°</text></g></>)}
        <g class="dim"><path class="dl" d="M598 500 L626 528" /><rect x="636" y="500" width="150" height="30" /><text x="711" y="522">8.5 px · touch</text></g>
      </g>
      <circle class="lens" data-lens cx="-500" cy="-500" r="190" />
    </svg>
    <ul class="legend" aria-label="Lines: hover one to isolate it">
      {LINES.map((l) => <li><button type="button" data-line={l.id} style={`--c:${l.color};--ink:${l.ink}`}>{l.id}</button></li>)}
    </ul>
    <figcaption>The network as it ran in 2020, redrawn after the official map.</figcaption>
  </figure>

  <ol class="rules" aria-label="Rules the loupe shows">
    {rules.map((r, i) => <li><b>{i + 1}</b>{r}</li>)}
  </ol>

</section>

<style>
  .xray { margin:2rem 0 0; }
  .xray-bar { display:flex; gap:1rem; align-items:center; margin-bottom:.6rem; }
  .xray-bar button { border:2px solid #111; background:#faf9f6; font:inherit; font-weight:700; font-size:.8125rem; padding:.3rem .8rem; border-radius:999px; cursor:pointer; }
  .xray-bar button[aria-pressed="true"] { background:#111; color:#faf9f6; }
  .hint { font-size:.8125rem; color:#666; }
  .orig { margin-left:auto; font-size:.8125rem; font-weight:700; color:#111; }
  svg { display:block; width:100%; height:auto; background:#fff; border-radius:12px; cursor:crosshair; touch-action:pan-y; }
  .focus-layer { display:none; }
  .xray[data-focus] .focus-layer { display:inline; }
  .focus-layer path { fill:none; stroke-width:8; stroke-linejoin:round; }
  .focus-layer g { display:none; }
  .hull { fill:none; stroke:#111; stroke-opacity:.12; stroke-width:8; stroke-linejoin:round; }
  .cl { fill:none; stroke:#111; stroke-width:1.4; }
  .arc { fill:#e3273930; stroke:#e32739; stroke-width:2; }
  .dim rect { fill:#111; }
  .dim text { fill:#fff; font:700 18px var(--campaign); text-anchor:middle; }
  .dl { stroke:#e32739; stroke-width:3; }
  .lens { fill:none; stroke:#111; stroke-width:5; pointer-events:none; }
  .xray[data-rules] .lens { display:none; }
  .legend { list-style:none; display:flex; flex-wrap:wrap; gap:4px; padding:0; margin:.75rem 0 0; }
  .legend button { min-width:2.7rem; height:2rem; border:0; background:var(--c); color:var(--ink); font:700 .9375rem var(--campaign); letter-spacing:-.03em; border-radius:2px; cursor:pointer; }
  .rules { list-style:none; padding:0; margin:2rem 0 0; display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:.6rem 1.5rem; font-size:.875rem; }
  .rules li { display:flex; gap:.6rem; }
  .rules b { flex:none; display:inline-grid; place-items:center; width:1.4rem; height:1.4rem; background:#111; color:#fff; font-size:.75rem; }
</style>

<script>
  function initXray() {
    document.querySelectorAll<HTMLElement>('[data-xray]:not([data-initialized])').forEach((fig) => {
      fig.dataset.initialized = '';
      const svg = fig.querySelector<SVGSVGElement>('[data-xray-svg]')!;
      const loupe = svg.querySelector<SVGCircleElement>('[data-loupe]')!;
      const lens = svg.querySelector<SVGCircleElement>('[data-lens]')!;
      const move = (ev: PointerEvent) => {
        if (fig.dataset.rules !== undefined) return;
        const pt = svg.createSVGPoint(); pt.x = ev.clientX; pt.y = ev.clientY;
        const p = pt.matrixTransform(svg.getScreenCTM()!.inverse());
        [loupe, lens].forEach((c) => { c.setAttribute('cx', String(p.x)); c.setAttribute('cy', String(p.y)); });
      };
      svg.addEventListener('pointermove', move);
      svg.addEventListener('pointerdown', move);
      const all = fig.querySelector<HTMLButtonElement>('[data-all]')!;
      all.addEventListener('click', () => {
        const on = fig.dataset.rules === undefined;
        if (on) { fig.dataset.rules = ''; loupe.setAttribute('r', '4000'); } else { delete fig.dataset.rules; loupe.setAttribute('r', '190'); }
        all.setAttribute('aria-pressed', String(on));
      });
      fig.querySelectorAll<HTMLButtonElement>('[data-line]').forEach((b) => {
        const on = () => {
          fig.dataset.focus = b.dataset.line;
          fig.querySelectorAll<SVGGElement>('[data-fline]').forEach((g) => { g.style.display = g.dataset.fline === b.dataset.line ? 'inline' : 'none'; });
        };
        const off = () => { delete fig.dataset.focus; };
        b.addEventListener('mouseenter', on); b.addEventListener('focus', on); b.addEventListener('click', on);
        b.addEventListener('mouseleave', off); b.addEventListener('blur', off);
      });
    });
  }
  initXray();
  document.addEventListener('astro:page-load', initXray);
</script>
