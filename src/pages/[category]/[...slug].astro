---
import Base from '../../layouts/Base.astro';
import TagList from '../../components/TagList.astro';
import Figure from '../../components/Figure.astro';
import TwoCol from '../../components/TwoCol.astro';
import ThreeCol from '../../components/ThreeCol.astro';
import ImageGrid from '../../components/ImageGrid.astro';
import CaseStudyVisual from '../../components/CaseStudyVisual.astro';
import CaseStudyMetric from '../../components/CaseStudyMetric.astro';
import CaseStudyComparison from '../../components/CaseStudyComparison.astro';
import CaseStudyRoute from '../../components/CaseStudyRoute.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../config';
import type { CategoryId } from '../../config';

export async function getStaticPaths() {
  const paths = [];
  for (const cat of CATEGORIES) {
    const entries = await getCollection(cat.id);
    for (const entry of entries) {
      paths.push({
        params: { category: cat.id, slug: entry.slug },
        props:  { entry, category: cat },
      });
    }
  }
  return paths;
}

const { entry, category } = Astro.props;
const { Content } = await entry.render();
const isCaseStudy = entry.data.pageStyle === 'case-study';

const dateStr = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<Base title={entry.data.title} description={entry.data.description} image={entry.data.cover}>
  <a href={`/${category.id}/`} class="back">{category.label}</a>

  <article class:list={{ 'case-study': isCaseStudy }}>
    <header class="article-header">
      {isCaseStudy && <p class="case-study-kicker">Case study · {entry.data.context}</p>}
      <h1 class="article-title">{entry.data.title}</h1>
      {isCaseStudy && entry.data.description && (
        <p class="case-study-summary">{entry.data.description}</p>
      )}
      <div class="article-meta">
        <time datetime={entry.data.date.toISOString()}>{dateStr}</time>
        {entry.data.tags.length > 0 && (
          <TagList tags={entry.data.tags} />
        )}
      </div>
      {isCaseStudy && (
        <dl class="case-study-meta">
          {entry.data.client && <div><dt>Subject</dt><dd>{entry.data.client}</dd></div>}
          {entry.data.role && <div><dt>Role</dt><dd>{entry.data.role}</dd></div>}
          {entry.data.duration && <div><dt>When</dt><dd>{entry.data.duration}</dd></div>}
          {entry.data.deliverables.length > 0 && (
            <div><dt>Deliverables</dt><dd>{entry.data.deliverables.join(' · ')}</dd></div>
          )}
        </dl>
      )}
    </header>

    <div class:list={['prose', { 'case-study-body': isCaseStudy }]}>
      <Content components={{
        Figure,
        TwoCol,
        ThreeCol,
        ImageGrid,
        CaseStudyVisual,
        CaseStudyMetric,
        CaseStudyComparison,
        CaseStudyRoute,
      }} />
    </div>
    {isCaseStudy && entry.data.disclaimer && (
      <p class="case-study-disclaimer">{entry.data.disclaimer}</p>
    )}
  </article>
</Base>
