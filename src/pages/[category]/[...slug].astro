---
import Base from '../../layouts/Base.astro';
import TagList from '../../components/TagList.astro';
import Figure from '../../components/Figure.astro';
import TwoCol from '../../components/TwoCol.astro';
import ThreeCol from '../../components/ThreeCol.astro';
import ImageGrid from '../../components/ImageGrid.astro';
import CaseStudyStats from '../../components/CaseStudyStats.astro';
import CaseStudyPoster from '../../components/CaseStudyPoster.astro';
import CaseStudyPhotoPair from '../../components/CaseStudyPhotoPair.astro';
import CaseStudyRealRoute from '../../components/CaseStudyRealRoute.astro';
import CaseStudySystemDiagram from '../../components/CaseStudySystemDiagram.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../config';
import type { CategoryId } from '../../config';

export async function getStaticPaths() {
  const paths = [];
  for (const cat of CATEGORIES) {
    const entries = await getCollection(cat.id);
    for (const entry of entries) {
      paths.push({
        params: { category: cat.id, slug: entry.slug },
        props:  { entry, category: cat },
      });
    }
  }
  return paths;
}

const { entry, category } = Astro.props;
const { Content } = await entry.render();
const isCaseStudy = entry.data.pageStyle === 'case-study';

const dateStr = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const socialImage = entry.data.socialImage ?? entry.data.cover;
const creativeWork = isCaseStudy ? {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: entry.data.title,
  description: entry.data.description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  image: socialImage ? new URL(socialImage, Astro.site).href : undefined,
  author: {
    '@type': 'Person',
    name: 'Martí Bravo',
    url: 'https://github.com/martibravo',
  },
  dateCreated: entry.data.date.toISOString().slice(0, 10),
  inLanguage: ['en', 'ca'],
  about: {
    '@type': 'Thing',
    name: 'Bicing',
    description: "Barcelona's public bicycle-sharing system",
  },
} : undefined;
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  image={socialImage}
  jsonLd={creativeWork}
>
  {isCaseStudy ? (
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`/${category.id}/`}>{category.label}</a>
      <span aria-hidden="true">→</span>
      <span aria-current="page">{entry.data.title}</span>
    </nav>
  ) : (
    <a href={`/${category.id}/`} class="back">{category.label}</a>
  )}

  <article class:list={{ 'case-study': isCaseStudy }}>
    <header class="article-header">
      <h1 class="article-title">
        {entry.data.titleLines
          ? entry.data.titleLines.map((line) => <span class="article-title-line">{line}</span>)
          : entry.data.title}
      </h1>
      {isCaseStudy && (
        <p class="case-study-context">Brand and campaign exploration for the Art Direction course at BAU, College of Arts and Design of Barcelona.</p>
      )}
      {isCaseStudy && entry.data.description && (
        <p class="case-study-summary">{entry.data.description}</p>
      )}
      {!isCaseStudy && (
        <div class="article-meta">
          <time datetime={entry.data.date.toISOString()}>{dateStr}</time>
          {entry.data.tags.length > 0 && (
            <TagList tags={entry.data.tags} />
          )}
        </div>
      )}
      {isCaseStudy && (
        <dl class="case-study-meta">
          {entry.data.client && <div><dt>Subject</dt><dd>{entry.data.client}</dd></div>}
          {entry.data.role && <div><dt>Role</dt><dd>{entry.data.role}</dd></div>}
          {entry.data.context && <div><dt>Course</dt><dd>{entry.data.context}</dd></div>}
          {entry.data.deliverables.length > 0 && (
            <div><dt>Output</dt><dd>{entry.data.deliverables.join(', ')}</dd></div>
          )}
        </dl>
      )}
    </header>

    <div class:list={['prose', { 'case-study-body': isCaseStudy }]}>
      <Content components={{
        Figure,
        TwoCol,
        ThreeCol,
        ImageGrid,
        CaseStudyStats,
        CaseStudyPoster,
        CaseStudyPhotoPair,
        CaseStudyRealRoute,
        CaseStudySystemDiagram,
      }} />
    </div>
  </article>
</Base>
